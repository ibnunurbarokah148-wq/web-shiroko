<%- include('partials/header') %>

<div class="status-page">
    <header class="status-hero">
        <div>
            <div class="eyebrow"><span class="eyebrow-line"></span> PUBLIC STATUS</div>
            <h1>Shiroko system status</h1>
            <p>Status koneksi bot dan infrastruktur Minecraft secara langsung.</p>
        </div>
        <div class="status-clock"><span>LAST CHECK</span><strong id="status-clock">--:--:--</strong></div>
    </header>

    <section class="status-overview <%= data.summary.globalStatus.toLowerCase() %>">
        <div class="overview-icon"><i class="fas <%= data.summary.globalStatus === 'OPERATIONAL' ? 'fa-circle-check' : data.summary.globalStatus === 'DEGRADED' ? 'fa-triangle-exclamation' : 'fa-circle-xmark' %>"></i></div>
        <div>
            <span class="panel-kicker">CURRENT CONDITION</span>
            <h2><%= data.summary.globalStatus === 'OPERATIONAL' ? 'All systems operational' : data.summary.globalStatus === 'DEGRADED' ? 'Some services are degraded' : 'Core services unavailable' %></h2>
            <p><%= data.summary.onlineServices %> dari <%= data.summary.totalServices %> layanan inti mengirimkan sinyal online.</p>
        </div>
        <div class="overview-score"><strong><%= Math.round((data.summary.onlineServices / data.summary.totalServices) * 100) %>%</strong><span>availability</span></div>
    </section>

    <section class="status-content-grid">
        <article class="panel status-services-panel">
            <header class="panel-header"><div><span class="panel-kicker">CORE SERVICES</span><h2>Service availability</h2></div></header>
            <div class="status-service-list">
                <% data.services.forEach(service => { %>
                    <div class="status-service-row">
                        <span class="service-icon <%= service.accent %>"><i class="<%= service.icon %>"></i></span>
                        <div class="status-service-copy"><strong><%= service.name %></strong><p><%= service.description %></p></div>
                        <div class="status-bars" aria-label="Riwayat uptime dekoratif">
                            <% for (let index = 0; index < 22; index++) { %><i class="<%= service.status.toLowerCase() %>"></i><% } %>
                        </div>
                        <span class="service-state <%= service.status.toLowerCase() %>"><i></i><%= service.status %></span>
                    </div>
                <% }) %>
            </div>
        </article>

        <aside class="panel status-meta-panel">
            <header class="panel-header"><div><span class="panel-kicker">MONITOR</span><h2>Monitoring info</h2></div></header>
            <dl class="monitor-list">
                <div><dt>Update interval</dt><dd>30 detik</dd></div>
                <div><dt>Core services</dt><dd><%= data.summary.totalServices %></dd></div>
                <div><dt>Services online</dt><dd class="positive"><%= data.summary.onlineServices %></dd></div>
                <div><dt>Status source</dt><dd>VPS & Pterodactyl</dd></div>
            </dl>
            <div class="status-note"><i class="fas fa-circle-info"></i><p>Status dapat tertunda saat VPS sedang deploy atau restart.</p></div>
        </aside>
    </section>

    <section class="panel incident-panel">
        <header class="panel-header"><div><span class="panel-kicker">INCIDENT HISTORY</span><h2>Recent incidents</h2></div><span class="incident-clear"><i class="fas fa-check"></i> No active incidents</span></header>
        <div class="empty-incident"><i class="fas fa-shield-halved"></i><div><strong>Tidak ada insiden aktif</strong><p>Semua service yang terhubung bekerja dalam kondisi normal.</p></div></div>
    </section>
</div>

<style>
.status-page { width: min(1200px, calc(100% - 48px)); margin: auto; padding: 54px 0 76px; }
.status-hero { display:flex; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:26px; }
.status-hero h1 { font-size:clamp(30px,5vw,48px); letter-spacing:-.05em; }
.status-hero p { margin-top:10px; color:var(--text-secondary); font-size:13px; }
.status-clock { text-align:right; }.status-clock span { display:block; color:var(--text-muted); font:700 8px 'JetBrains Mono',monospace; letter-spacing:.16em; }.status-clock strong { display:block; margin-top:5px; font:600 16px 'JetBrains Mono',monospace; color:var(--accent-color); }
.status-overview { display:grid; grid-template-columns:58px 1fr auto; align-items:center; gap:18px; padding:24px; margin-bottom:16px; border:1px solid rgba(54,216,121,.25); border-radius:16px; background:linear-gradient(90deg,rgba(54,216,121,.08),rgba(17,26,45,.96)); }
.overview-icon { width:52px; height:52px; display:grid; place-items:center; border-radius:14px; color:var(--online-color); background:rgba(54,216,121,.1); font-size:22px; }.status-overview h2 { margin:4px 0; font-size:20px; }.status-overview p { color:var(--text-secondary); font-size:11px; }.overview-score { text-align:right; }.overview-score strong { display:block; color:var(--online-color); font:700 26px 'JetBrains Mono',monospace; }.overview-score span { color:var(--text-muted); font-size:9px; }
.status-overview.degraded { border-color:rgba(246,200,95,.3); background:linear-gradient(90deg,rgba(246,200,95,.08),rgba(17,26,45,.96)); }.status-overview.degraded .overview-icon,.status-overview.degraded .overview-score strong { color:var(--warning-color); }.status-overview.offline { border-color:rgba(255,95,100,.3); }.status-overview.offline .overview-icon,.status-overview.offline .overview-score strong { color:var(--offline-color); }
.status-content-grid { display:grid; grid-template-columns:1.65fr .7fr; gap:16px; margin-bottom:16px; }.status-service-list { padding:4px 20px 12px; }.status-service-row { min-height:78px; display:grid; grid-template-columns:40px minmax(180px,1fr) 180px 70px; align-items:center; gap:12px; border-bottom:1px solid rgba(38,55,84,.65); }.status-service-row:last-child { border:0; }.status-service-copy strong { font-size:14px; }.status-service-copy p { margin-top:4px; color:var(--text-muted); font-size:11px; line-height:1.5; }.status-bars { display:flex; gap:3px; height:20px; align-items:stretch; }.status-bars i { flex:1; border-radius:2px; background:var(--online-color); opacity:.7; }.status-bars i.standby { background:var(--warning-color); }.status-bars i.offline { background:var(--offline-color); }
.monitor-list { padding:8px 20px 16px; }.monitor-list div { display:flex; justify-content:space-between; gap:16px; padding:15px 0; border-bottom:1px solid rgba(38,55,84,.65); font-size:12px; }.monitor-list dt { color:var(--text-muted); }.monitor-list dd { color:var(--text-secondary); font-family:'JetBrains Mono',monospace; }.monitor-list dd.positive { color:var(--online-color); }.status-note { display:flex; gap:10px; margin:0 18px 18px; padding:12px; border:1px solid rgba(84,184,255,.16); border-radius:10px; color:var(--accent-color); background:rgba(84,184,255,.06); }.status-note p { color:var(--text-secondary); font-size:9px; }
.incident-clear { color:var(--online-color); font:600 9px 'JetBrains Mono',monospace; }.empty-incident { display:flex; align-items:center; justify-content:center; gap:14px; min-height:130px; color:var(--accent-color); }.empty-incident > i { font-size:25px; }.empty-incident strong { font-size:12px; color:var(--text-primary); }.empty-incident p { color:var(--text-muted); font-size:9px; margin-top:4px; }
@media(max-width:900px){.status-content-grid{grid-template-columns:1fr}.status-service-row{grid-template-columns:40px 1fr auto}.status-bars{display:none}}
@media(max-width:600px){.status-page{width:calc(100% - 28px);padding-top:32px}.status-hero{align-items:flex-start;flex-direction:column}.status-clock{text-align:left}.status-overview{grid-template-columns:48px 1fr}.overview-score{grid-column:2;text-align:left}.status-service-row{grid-template-columns:36px 1fr}.status-service-row>.service-state{grid-column:2;padding-bottom:10px}.incident-clear{display:none}.empty-incident{padding:20px;justify-content:flex-start}}
</style>
<script>
(function updateClock(){
    const clock = document.getElementById('status-clock');
    if (clock) clock.textContent = new Date().toLocaleTimeString('id-ID', { hour12: false });
    window.setTimeout(updateClock, 1000);
}());
</script>

<%- include('partials/footer') %>
