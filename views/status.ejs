<%- include('partials/header') %>

<section class="section-padding" style="padding-top: 150px; min-height: 80vh;">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h1 class="glitch" data-text="System Status">System Status</h1>
            <p class="subtitle">Pantau status *uptime* dan ketersediaan layanan ekosistem Shiroko secara real-time.</p>
        </div>

        <div class="status-board" data-aos="fade-up" data-aos-delay="100">
            <!-- Summary Header -->
            <div class="status-summary">
                <% 
                   const servicesList = (data && data.services && data.services.length > 0) ? data.services : [
                       { name: 'WhatsApp Bot', status: 'ONLINE', icon: 'fab fa-whatsapp' },
                       { name: 'Discord Bot', status: 'ONLINE', icon: 'fab fa-discord' },
                       { name: 'Google Gemini', status: 'ONLINE', icon: 'fas fa-brain' },
                       { name: 'OpenRouter AI', status: 'ONLINE', icon: 'fas fa-network-wired' },
                       { name: 'Cloudflare AI', status: 'ONLINE', icon: 'fas fa-cloud' },
                       { name: 'ArisuSoft AI', status: 'ONLINE', icon: 'fas fa-robot' },
                       { name: 'PixAI Engine', status: 'ONLINE', icon: 'fas fa-palette' },
                       { name: 'Server Minecraft', status: 'ONLINE', icon: 'fas fa-cube' },
                       { name: 'Local AI (Ollama)', status: 'STANDBY', icon: 'fas fa-server' }
                   ];
                   const onlineCount = servicesList.filter(s => s.status === 'ONLINE').length;
                   const totalCount = servicesList.length;
                %>
                <% if(onlineCount >= totalCount - 1) { %>
                    <i class="fas fa-check-circle" style="color: #4CAF50; font-size: 3rem; margin-bottom: 1rem;"></i>
                    <h2>All Systems Operational</h2>
                <% } else if(onlineCount > 0) { %>
                    <i class="fas fa-exclamation-triangle" style="color: #f39c12; font-size: 3rem; margin-bottom: 1rem;"></i>
                    <h2>Partial System Outage</h2>
                <% } else { %>
                    <i class="fas fa-times-circle" style="color: #e74c3c; font-size: 3rem; margin-bottom: 1rem;"></i>
                    <h2>Major System Outage</h2>
                <% } %>
                <p style="color: var(--text-secondary);"><%= onlineCount %> dari <%= totalCount %> Layanan Online | Last updated: <span id="time-now">Just now</span></p>
            </div>

            <!-- List of 9 Services -->
            <div class="status-list mt-4">
                <% servicesList.forEach(service => { %>
                    <div class="status-item">
                        <div class="service-info">
                            <i class="<%= service.icon %>" style="font-size: 1.5rem; width: 30px; text-align: center; color: var(--accent-color);"></i>
                            <span class="service-name"><%= service.name %></span>
                        </div>
                        <div class="service-state <%= service.status === 'ONLINE' ? 'online' : (service.status === 'STANDBY' ? 'standby' : 'offline') %>">
                            <span class="dot"></span> <%= service.status %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</section>

<style>
.mb-5 { margin-bottom: 3rem; }
.mt-4 { margin-top: 2rem; }

.status-board {
    max-width: 800px;
    margin: 0 auto;
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 15px;
    padding: 3rem 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
}

.status-summary {
    text-align: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
}

.status-summary h2 {
    color: var(--text-primary);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
}

.status-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--bg-color);
    border-radius: 10px;
    margin-bottom: 1rem;
    border: 1px solid var(--border-color);
    transition: transform 0.2s ease;
}

.status-item:hover {
    transform: translateX(5px);
    border-color: var(--accent-color);
}

.service-info {
    display: flex;
    align-items: center;
    gap: 15px;
}

.service-name {
    font-size: 1.1rem;
    color: var(--text-primary);
    font-weight: 500;
}

.service-state {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 1px;
}

.service-state.online { 
    color: #4CAF50; 
    background: transparent;
    box-shadow: none;
}
.service-state.offline { 
    color: #e74c3c; 
    background: transparent;
    box-shadow: none;
}

.service-state .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.service-state.online .dot {
    background-color: #4CAF50;
    box-shadow: 0 0 10px #4CAF50;
    animation: pulse-green 2s infinite;
}

.service-state.offline .dot {
    background-color: #e74c3c;
    box-shadow: 0 0 10px #e74c3c;
}

@keyframes pulse-green {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(76, 175, 80, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(76, 175, 80, 0); }
}
@media (max-width: 768px) {
    .status-board {
        padding: 1.5rem 1rem;
    }
    .status-summary h2 {
        font-size: 1.5rem;
    }
    .status-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
    .service-state {
        align-self: flex-start;
    }
}
</style>

<script>
    document.getElementById('time-now').textContent = new Date().toLocaleString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB';
</script>

<%- include('partials/footer') %>



