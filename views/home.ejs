<%- include('partials/header') %>

<div class="dashboard-shell" id="ecosystem-dashboard">
    <header class="dashboard-header">
        <div>
            <div class="eyebrow"><span class="eyebrow-line"></span> SHIROKO OPERATIONS</div>
            <h1>Selamat datang kembali, <span>Sensei.</span></h1>
            <p>Pantau bot, layanan AI, dan server Minecraft dari satu pusat kendali.</p>
        </div>
        <div class="dashboard-header-actions">
            <div class="live-indicator <%= data.summary.globalStatus.toLowerCase() %>" id="global-status">
                <span class="status-dot"></span>
                <div>
                    <small>ECOSYSTEM STATUS</small>
                    <strong id="global-status-label"><%= data.summary.globalStatus === 'OPERATIONAL' ? 'All systems operational' : data.summary.globalStatus === 'UNKNOWN' ? 'Telemetry unavailable' : data.summary.globalStatus %></strong>
                </div>
            </div>
            <button class="icon-button" id="refresh-dashboard" type="button" aria-label="Perbarui dashboard"><i class="fas fa-rotate" aria-hidden="true"></i></button>
        </div>
    </header>

    <section class="persona-banner" aria-label="Pesan Shiroko">
        <img src="/assets/img/logo.jpeg" alt="Persona Shiroko" class="persona-avatar">
        <div class="persona-copy">
            <span class="persona-name">SHIROKO</span>
            <p id="shiroko-message"><%= data.dataSource === 'live' ? 'Semua kanal sedang kupantau.' : 'Telemetry bot belum terhubung; status belum dapat dipastikan.' %> Data terakhir diperbarui <time id="last-updated"><%= data.updatedAt ? new Date(data.updatedAt).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '--:--:--' %></time>.</p>
        </div>
        <div class="signal-bars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    </section>

    <section class="kpi-grid" aria-label="Ringkasan ekosistem">
        <article class="kpi-card featured">
            <div class="kpi-top"><span>Pesan diproses</span><i class="fas fa-message"></i></div>
            <strong class="metric" id="stat-totalChat"><%= data.summary.totalChat.toLocaleString('id-ID') %></strong>
            <div class="metric-meta"><span class="trend positive"><i class="fas fa-arrow-trend-up"></i> Live</span><span>semua platform</span></div>
        </article>
        <article class="kpi-card">
            <div class="kpi-top"><span>Pengguna terhubung</span><i class="fas fa-users"></i></div>
            <strong class="metric" id="stat-activeUsers"><%= data.summary.activeUsers.toLocaleString('id-ID') %></strong>
            <div class="metric-meta"><span><b id="stat-whatsappUsers"><%= data.summary.whatsappUsers.toLocaleString('id-ID') %></b> WA</span><span><b id="stat-discordUsers"><%= data.summary.discordUsers.toLocaleString('id-ID') %></b> Discord</span></div>
        </article>
        <article class="kpi-card">
            <div class="kpi-top"><span>AI requests</span><i class="fas fa-brain"></i></div>
            <strong class="metric" id="stat-aiRequests"><%= data.summary.aiRequests.toLocaleString('id-ID') %></strong>
            <div class="metric-meta"><span class="trend positive"><i class="fas fa-bolt"></i> Active</span><span>provider terintegrasi</span></div>
        </article>
        <article class="kpi-card">
            <div class="kpi-top"><span>Commands</span><i class="fas fa-terminal"></i></div>
            <strong class="metric" id="stat-commands"><%= data.summary.commands.toLocaleString('id-ID') %></strong>
            <div class="metric-meta"><span><b id="online-count"><%= data.summary.onlineServices %>/<%= data.summary.totalServices %></b> core online</span><span>hari ini</span></div>
        </article>
    </section>

    <section class="dashboard-grid">
        <article class="panel activity-panel">
            <header class="panel-header">
                <div><span class="panel-kicker"><%= data.activitySeries ? 'LIVE TRAFFIC' : 'ACTIVITY PREVIEW' %></span><h2>Aktivitas ekosistem</h2></div>
                <div class="chart-legend"><span class="whatsapp">WhatsApp</span><span class="discord">Discord</span><span class="minecraft">Minecraft</span></div>
            </header>
            <div class="chart-wrap" data-series='<%- JSON.stringify(data.activitySeries || null) %>'>
                <canvas id="activity-chart" aria-label="Grafik aktivitas platform"></canvas>
                <% if (!data.activitySeries) { %><span class="chart-demo-badge">DATA DEMO</span><% } %>
            </div>
        </article>

        <aside class="panel health-panel">
            <header class="panel-header">
                <div><span class="panel-kicker">SYSTEM HEALTH</span><h2>Core services</h2></div>
                <a href="/status" class="panel-link">Lihat semua <i class="fas fa-arrow-right"></i></a>
            </header>
            <div class="health-score">
                <div class="health-ring" id="health-ring" style="--score: <%= data.summary.totalServices ? (data.summary.onlineServices / data.summary.totalServices) * 360 : 0 %>deg">
                    <span><b id="health-percentage"><%= data.summary.totalServices ? Math.round((data.summary.onlineServices / data.summary.totalServices) * 100) : '--' %></b><%= data.summary.totalServices ? '%' : '' %></span>
                </div>
                <div><strong>Operational score</strong><p>Ketersediaan empat layanan inti.</p></div>
            </div>
            <div class="compact-service-list" id="compact-service-list">
                <% data.services.forEach(service => { %>
                    <div class="compact-service" data-service-id="<%= service.id %>">
                        <span class="service-icon <%= service.accent %>"><i class="<%= service.icon %>"></i></span>
                        <div><strong><%= service.name %></strong><small><%= service.description %></small></div>
                        <span class="service-state <%= service.status.toLowerCase() %>"><i></i><%= service.status %></span>
                    </div>
                <% }) %>
            </div>
        </aside>
    </section>

    <section class="services-section">
        <header class="section-heading">
            <div><span class="panel-kicker">CONNECTED PLATFORMS</span><h2>Shiroko ecosystem</h2></div>
            <a href="/projects" class="btn btn-outline">Jelajahi ekosistem <i class="fas fa-arrow-right"></i></a>
        </header>
        <div class="service-grid" id="service-grid">
            <% data.services.forEach(service => { %>
                <article class="service-card <%= service.accent %>" data-service-id="<%= service.id %>">
                    <div class="service-card-top">
                        <span class="service-icon <%= service.accent %>"><i class="<%= service.icon %>"></i></span>
                        <span class="service-state <%= service.status.toLowerCase() %>"><i></i><%= service.status %></span>
                    </div>
                    <h3><%= service.name %></h3>
                    <p><%= service.description %></p>
                    <div class="service-card-footer"><span>Heartbeat</span><strong><%= service.status === 'ONLINE' ? 'Connected' : 'Awaiting signal' %></strong></div>
                </article>
            <% }) %>
        </div>
    </section>

    <section class="bottom-grid">
        <article class="panel terminal-panel">
            <header class="panel-header"><div><span class="panel-kicker">RECENT SIGNALS</span><h2>Activity feed</h2></div><span class="terminal-live"><i></i> LIVE</span></header>
            <div class="activity-feed" id="activity-feed">
                <% if (data.activity.length) { %>
                    <% data.activity.forEach(item => { %><div class="activity-row"><time><%= item.time || '--:--' %></time><i class="fas fa-circle-nodes"></i><p><%= item.message || item.title %></p></div><% }) %>
                <% } else { %>
                    <div class="activity-row is-empty"><time>--:--</time><i class="fas fa-satellite-dish"></i><p>Belum ada event telemetry yang diterima dari bot.</p></div>
                <% } %>
            </div>
        </article>
        <article class="panel quick-panel">
            <header class="panel-header"><div><span class="panel-kicker">QUICK ACCESS</span><h2>Command shortcuts</h2></div></header>
            <div class="quick-links">
                <a href="/status"><span><i class="fas fa-wave-square"></i></span><div><strong>System status</strong><small>Periksa semua layanan</small></div><i class="fas fa-chevron-right"></i></a>
                <a href="/projects"><span><i class="fas fa-cubes"></i></span><div><strong>Project ecosystem</strong><small>Bot dan Minecraft</small></div><i class="fas fa-chevron-right"></i></a>
                <a href="/admin"><span><i class="fas fa-shield-halved"></i></span><div><strong>Admin console</strong><small>Kontrol dan deployment</small></div><i class="fas fa-chevron-right"></i></a>
            </div>
        </article>
    </section>
</div>

<%- include('partials/footer') %>
