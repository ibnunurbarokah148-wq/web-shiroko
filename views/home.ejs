<script>
    // Live update statistics
    async function updateStats() {
        try {
            const res = await fetch('/api/stats');
            if (res.ok) {
                const stats = await res.json();
                document.getElementById('stat-totalChat').innerText = stats.totalChat;
                document.getElementById('stat-imageGenerated').innerText = stats.imageGenerated;
                document.getElementById('stat-discordUsers').innerText = stats.discordUsers;
                document.getElementById('stat-whatsappUsers').innerText = stats.whatsappUsers;
                document.getElementById('stat-aiRequests').innerText = stats.aiRequests;
                document.getElementById('stat-commands').innerText = stats.commands;
            }
        } catch (err) {
            console.error('Failed to update stats:', err);
        }
    }
    
    // Update every 5 seconds
    setInterval(updateStats, 5000);
</script>

