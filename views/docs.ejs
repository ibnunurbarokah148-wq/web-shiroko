<style>
.mb-5 { margin-bottom: 3rem; }
.mt-5 { margin-top: 3rem; }

.docs-layout {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
}

.docs-sidebar {
    position: sticky;
    top: 100px;
    width: 250px;
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    flex-shrink: 0;
}

.docs-nav ul {
