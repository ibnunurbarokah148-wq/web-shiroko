    padding: 0;
}

.docs-nav li {
    margin-bottom: 0.5rem;
}

.docs-nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-secondary);
    padding: 10px 15px;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.docs-nav a:hover, .docs-nav a.active {
    background: rgba(0, 176, 240, 0.1);
    color: var(--accent-color);
}

.docs-content {
    flex-grow: 1;
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2.5rem;
}

.doc-section h2 {
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 10px;
    margin-bottom: 15px;
    font-size: 1.8rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

.doc-section p {
    color: var(--text-secondary);
    margin-bottom: 20px;
}

.command-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.command-item {
    background: var(--bg-color);
    border-left: 4px solid var(--accent-color);
    padding: 15px 20px;
    border-radius: 0 8px 8px 0;
}

.cmd-badge {
    display: inline-block;
    background: rgba(0, 176, 240, 0.15);
    color: var(--accent-color);
    padding: 4px 10px;
    border-radius: 6px;
    font-family: monospace;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 8px;
}

.command-item p {
    margin-bottom: 0;
    font-size: 0.95rem;
}

/* Tab Content Visibility & Animations */
.doc-section {
    display: none;
    animation: fadeSlideUp 0.4s ease forwards;
}

.doc-section.active {
    display: block;
}

@keyframes fadeSlideUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 768px) {
    .docs-layout {
        flex-direction: column;
    }
    .docs-sidebar {
        width: 100%;
        position: static;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('.docs-nav a');
    const sections = document.querySelectorAll('.doc-section');

    // Function to switch tab
    function switchTab(targetId) {
        // Update Nav
        navLinks.forEach(l => {
            if (l.getAttribute('href') === targetId) {
                l.classList.add('active');
            } else {
                l.classList.remove('active');
            }
        });
        
        // Update Sections
        sections.forEach(sec => sec.classList.remove('active'));
        const targetSec = document.querySelector(targetId);
        if(targetSec) {
            targetSec.classList.add('active');
        }
    }

    // Determine initial tab from URL hash or default to #ai
    let currentHash = window.location.hash || '#ai';
    if (!document.querySelector(currentHash)) {
        currentHash = '#ai';
    }
    switchTab(currentHash);

    // Event listener for clicks
    navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.getAttribute('href');
            switchTab(targetId);
            
            // Update URL hash without jumping
            history.pushState(null, null, targetId);
        });
    });
});
</script>

