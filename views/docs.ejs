<script>
document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('.docs-nav a');
    const sections = document.querySelectorAll('.doc-section');

    // Function to switch tab
    function switchTab(targetId) {
        // Update Nav
        navLinks.forEach(l => {
            if (l.getAttribute('href') === targetId) {
                l.classList.add('active');
            } else {
                l.classList.remove('active');
            }
        });
        
        // Update Sections
        sections.forEach(sec => sec.classList.remove('active'));
        const targetSec = document.querySelector(targetId);
        if(targetSec) {
            targetSec.classList.add('active');
        }
    }

    // Determine initial tab from URL hash or default to #ai
    let currentHash = window.location.hash || '#overview';
    if (!document.querySelector(currentHash)) {
        currentHash = '#overview';
    }
    switchTab(currentHash);

    // Event listener for clicks
    navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.getAttribute('href');
            switchTab(targetId);
            history.pushState(null, '', targetId);
            if (window.innerWidth <= 768) {
                document.querySelector('.docs-content').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });

    window.addEventListener('popstate', () => {
        const targetId = window.location.hash && document.querySelector(window.location.hash) ? window.location.hash : '#overview';
        switchTab(targetId);
    });
});
</script>

