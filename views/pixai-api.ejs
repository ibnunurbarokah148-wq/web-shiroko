<%- include('partials/header') %>

<section class="section-padding" style="padding-top: 150px; min-height: 80vh;">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h1 class="glitch" data-text="PixAI Web Auth">PixAI Web Auth</h1>
            <p class="subtitle">Generator Token 1-Click untuk Bot Shiroko</p>
        </div>

        <div class="auth-card mx-auto" data-aos="fade-up" data-aos-delay="100" style="max-width: 600px; background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 15px; padding: 2.5rem; text-align: left;">
            <div id="otp-section">
                <h3 style="margin-bottom: 15px; color: var(--text-primary);">1. Masukkan Kode OTP</h3>
                <p style="color: var(--text-secondary); margin-bottom: 20px; font-size: 14px;">
                    Dapatkan kode OTP dari WhatsApp Bot Shiroko dengan mengetik perintah <strong>!api-pixai</strong>. Kode berlaku selama 5 menit.
                </p>
                <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                    <input type="text" id="otp-input" placeholder="SRO-XXXX" style="flex: 1; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.2); color: #fff; text-transform: uppercase;" autocomplete="off">
                    <button id="btn-generate" class="btn btn-primary">Generate</button>
                </div>
                <div id="otp-error" style="color: #ef4444; font-size: 14px; display: none; margin-bottom: 15px;"></div>
            </div>

            <div id="result-section" style="display: none; border-top: 1px solid var(--border-color); padding-top: 20px; margin-top: 10px;">
                <h3 style="margin-bottom: 15px; color: var(--accent-color);">2. Eksekusi Bookmarklet</h3>
                <p style="color: var(--text-secondary); margin-bottom: 15px; font-size: 14px;">
                    Salin kode unik di bawah ini, buka tab <strong>pixai.art</strong>, ketik <strong>javascript:</strong> di address bar lalu paste kode di belakangnya.
                </p>
                <textarea id="payload-output" readonly onclick="this.select()" style="width:100%; height:120px; background:rgba(0,0,0,0.3); color:#38bdf8; border:1px solid var(--border-color); border-radius:8px; padding:12px; font-size:11px; resize:none; font-family: monospace;"></textarea>
                <p style="color: var(--text-secondary); margin-top: 15px; font-size: 13px;">
                    <em>*Kode ini menggunakan sistem Polymorphic Obfuscation dan hanya bisa dipakai satu kali (OTP Nonce).</em>
                </p>
            </div>

            <div id="opsi-b-section" style="display: none; border-top: 1px solid var(--border-color); padding-top: 20px; margin-top: 20px;">
                <h3 style="margin-bottom: 15px; color: #10b981;">3. Opsi B: Tempel Token Manual (Jika Popup Muncul)</h3>
                <p style="color: var(--text-secondary); margin-bottom: 15px; font-size: 14px;">
                    Jika pada saat mengeksekusi Bookmarklet di atas browser menampilkan popup/prompt "Koneksi otomatis gagal...", silakan salin token JWT (eyJ...) yang ada di dalam popup tersebut dan tempelkan ke bawah ini:
                </p>
                <div style="display: flex; gap: 10px;">
                    <input type="text" id="manual-token-input" placeholder="eyJhbG..." style="flex: 1; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.2); color: #fff;" autocomplete="off">
                    <button id="btn-save-token" class="btn btn-secondary" style="background: #10b981; color: white;">Hubungkan ke Bot</button>
                </div>
                <div id="manual-alert" class="alert" style="display: none;"></div>
            </div>
        </div>
    </div>
</section>

<script>
document.getElementById('btn-generate').addEventListener('click', async () => {
    const otpInput = document.getElementById('otp-input').value.trim().toUpperCase();
    const errorDiv = document.getElementById('otp-error');
    const resultSection = document.getElementById('result-section');
    const btn = document.getElementById('btn-generate');

    errorDiv.style.display = 'none';
    
    if(!otpInput) {
        errorDiv.innerText = '⚠️ Harap masukkan kode OTP terlebih dahulu.';
        errorDiv.style.display = 'block';
        return;
    }

    btn.innerText = 'Loading...';
    btn.disabled = true;

    try {
        const botApiUrl = '/api/get-pixai-payload'; 
        const res = await fetch(botApiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ otp: otpInput })
        });
        
        const data = await res.json();
        
        if (data.status === 'ok') {
            document.getElementById('payload-output').value = data.payload;
            resultSection.style.display = 'block';
            document.getElementById('opsi-b-section').style.display = 'block';
            document.getElementById('otp-section').style.opacity = '0.5';
            document.getElementById('otp-input').disabled = true;
            btn.innerText = 'Sudah Digenerate';
            btn.disabled = true; // Permanently disable button after success
            btn.style.cursor = 'not-allowed';
            btn.style.opacity = '0.5';
        } else {
            errorDiv.innerHTML = data.message || 'Gagal generate bookmarklet.';
            errorDiv.style.display = 'block';
            resultSection.style.display = 'none';
            document.getElementById('opsi-b-section').style.display = 'none';
            btn.innerText = 'Generate';
            btn.disabled = false;
        }
    } catch(e) {
        errorDiv.innerHTML = '❌ Gagal terhubung ke API Bot VPS. Pastikan bot menyala.';
        errorDiv.style.display = 'block';
        btn.innerText = 'Generate';
        btn.disabled = false;
    }
});

// Handler Opsi B (Manual Token)
document.getElementById('btn-save-token').addEventListener('click', async () => {
    const tokenInput = document.getElementById('manual-token-input').value.trim();
    const alertDiv = document.getElementById('manual-alert');
    const btn = document.getElementById('btn-save-token');

    alertDiv.style.display = 'none';

    if(!tokenInput) {
        alertDiv.className = 'alert alert-error';
        alertDiv.innerHTML = '❌ Harap paste Token JWT terlebih dahulu.';
        alertDiv.style.display = 'block';
        return;
    }

    btn.innerText = 'Menyambungkan...';
    btn.disabled = true;

    try {
        const parts = tokenInput.split('|');
        const tokenVal = parts[0];
        const nonceVal = parts.length > 1 ? parts[1] : '';

        const res = await fetch('/api/save-pixai-token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: tokenVal, nonce: nonceVal })
        });
        const data = await res.json();

        if (res.ok && data.status === 'ok') {
            alertDiv.className = 'alert alert-success';
            alertDiv.innerHTML = '✅ <b>Sukses!</b><br>' + (data.message || 'Token berhasil dihubungkan ke Bot.');
            document.getElementById('manual-token-input').value = '';
        } else {
            alertDiv.className = 'alert alert-error';
            alertDiv.innerHTML = '❌ <b>Gagal:</b> ' + (data.message || 'Error tidak diketahui');
        }
    } catch(err) {
        alertDiv.className = 'alert alert-error';
        alertDiv.innerHTML = '❌ <b>Error:</b> Koneksi ke proxy server terputus.';
    } finally {
        btn.innerText = 'Hubungkan ke Bot';
        btn.disabled = false;
        alertDiv.style.display = 'block';
    }
});
</script>

<style>
.alert { padding: 12px; border-radius: 8px; font-size: 14px; margin-top: 15px; }
.alert-error { background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid #b91c1c; }
.alert-success { background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid #047857; }
</style>

<%- include('partials/footer') %>
