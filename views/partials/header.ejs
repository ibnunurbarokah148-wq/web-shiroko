<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b1020">
    <meta name="description" content="Shiroko Control Center untuk memantau WhatsApp Bot, Discord Bot, Minecraft Bot, dan Minecraft Server.">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/main.css?v=<%= assetVersion %>">
    <script>
        window.VPS_API_URL = <%- JSON.stringify(typeof vpsUrl !== 'undefined' ? vpsUrl : 'http://localhost:3000') %>;
    </script>
</head>
<body class="<%= typeof isHome !== 'undefined' && isHome ? 'dashboard-page' : '' %>">
    <div class="ambient-grid" aria-hidden="true"></div>
    <nav class="navbar" aria-label="Navigasi utama">
        <div class="nav-container">
            <a href="/" class="logo" aria-label="Shiroko Control Center">
                <img src="/assets/img/logo.jpeg" alt="" class="logo-img">
                <span class="logo-copy">
                    <strong>SHIROKO</strong>
                    <small>CONTROL CENTER</small>
                </span>
            </a>
            <div class="nav-links" id="primary-navigation">
                <a href="/" class="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>">Overview</a>
                <a href="/projects" class="<%= typeof currentPath !== 'undefined' && currentPath === '/projects' ? 'active' : '' %>">Ecosystem</a>
                <a href="/status" class="<%= typeof currentPath !== 'undefined' && currentPath === '/status' ? 'active' : '' %>">System Status</a>
                <a href="/docs" class="<%= typeof currentPath !== 'undefined' && currentPath === '/docs' ? 'active' : '' %>">Docs</a>
                <div class="nav-more">
                    <button type="button" aria-expanded="false">More <i class="fas fa-chevron-down" aria-hidden="true"></i></button>
                    <div class="nav-more-menu">
                        <a href="/gallery">Gallery</a>
                        <a href="/download">Download</a>
                        <a href="/changelog">Changelog</a>
                        <a href="/about">About</a>
                        <a href="/contact">Contact</a>
                    </div>
                </div>
            </div>
            <div class="nav-actions">
                <a href="/admin" class="btn btn-compact btn-outline"><i class="fas fa-shield-halved" aria-hidden="true"></i> Admin</a>
                <button class="hamburger" type="button" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="primary-navigation">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </nav>
    <main class="content">
