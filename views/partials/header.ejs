<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <% if (!(typeof isHome !== 'undefined' && isHome) && title !== 'Admin Login' && title !== 'Control Panel') { %>
    <!-- AOS CSS is only needed on pages using scroll animations. -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <% } %>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/css/main.css">

    <!-- Pass VPS URL to Client JS without delaying the document parser. -->
    <script>
        window.VPS_API_URL = <%- JSON.stringify(typeof vpsUrl !== 'undefined' ? vpsUrl : 'http://localhost:3000') %>;
        window.USE_AOS = <%= (!(typeof isHome !== 'undefined' && isHome) && title !== 'Admin Login' && title !== 'Control Panel') ? 'true' : 'false' %>;
    </script>
</head>
<body>
    <% if (typeof isHome !== 'undefined' && isHome) { %>
    <div id="particles-js" aria-hidden="true"></div>
    <% } %>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="/assets/img/logo.jpeg" alt="Shiroko Logo" class="logo-img">
                <span class="logo-text">SHIROKO</span>
            </a>
            <div class="nav-links" id="primary-navigation">
                <a href="/">Home</a>
                <a href="/projects">Projects</a>
                <a href="/docs">Documentation</a>
                <a href="/status">Status</a>
                <a href="/gallery">Gallery</a>
                <a href="/download">Download</a>
                <a href="/about">About</a>
            </div>
            <button class="hamburger" type="button" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="primary-navigation">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
        </div>
    </nav>

    <main class="content">
