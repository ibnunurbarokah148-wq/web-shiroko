<%- include('partials/header') %>

<section class="section-padding" style="padding-top: 150px; min-height: 80vh;">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h1 class="glitch" data-text="Ecosystem Projects">Ecosystem Projects</h1>
            <p class="subtitle">Detail lengkap mengenai setiap platform di dalam Shiroko Project.</p>
        </div>

        <div class="projects-wrapper">
            <!-- WhatsApp Bot -->
            <div class="project-detail-card" data-aos="fade-up" data-aos-delay="100">
                <div class="project-icon"><i class="fab fa-whatsapp"></i></div>
                <div class="project-content">
                    <h2>WhatsApp Bot (Shiroko)</h2>
                    <p class="desc">Bot WhatsApp cerdas yang dibangun menggunakan NodeJS dan Baileys. Memiliki fitur lengkap mulai dari percakapan AI, roleplay, hingga pembuatan gambar.</p>
                    
                    <div class="features-list">
                        <span class="feature"><i class="fas fa-check"></i> AI Assistant</span>
                        <span class="feature"><i class="fas fa-check"></i> Roleplay</span>
                        <span class="feature"><i class="fas fa-check"></i> ComfyUI (Image Gen)</span>
                        <span class="feature"><i class="fas fa-check"></i> Pembayaran QRIS Otomatis</span>
                        <span class="feature"><i class="fas fa-check"></i> Mode Akademik</span>
                    </div>

                    <div class="project-links mt-3">
                        <a href="/status" class="btn btn-outline"><i class="fas fa-signal"></i> Status</a>
                        <a href="/docs" class="btn btn-outline"><i class="fas fa-book"></i> Demo/Docs</a>
                        <a href="https://github.com/ibnunurbarokah148-wq/bot-shiroko" target="_blank" class="btn btn-primary"><i class="fab fa-github"></i> GitHub</a>
                    </div>
                </div>
            </div>

            <!-- Discord Bot -->
            <div class="project-detail-card" data-aos="fade-up" data-aos-delay="200">
                <div class="project-icon" style="color: #5865F2;"><i class="fab fa-discord"></i></div>
                <div class="project-content">
                    <h2>Discord Bot</h2>
                    <p class="desc">Bot Discord yang mendukung server komunitas, dengan ruang khusus waifu dan memori percakapan yang di-share dengan bot WhatsApp.</p>
                    
                    <div class="features-list">
                        <span class="feature"><i class="fas fa-check"></i> Waifu Room</span>
                        <span class="feature"><i class="fas fa-check"></i> Shared Memory (SQLite)</span>
                        <span class="feature"><i class="fas fa-check"></i> Model Picker</span>
                        <span class="feature"><i class="fas fa-check"></i> Voice / Music</span>
                    </div>

                    <div class="project-links mt-3">
                        <a href="https://discord.gg/k33xPSwWyx" target="_blank" class="btn btn-secondary"><i class="fab fa-discord"></i> Join Server</a>
                    </div>
                </div>
            </div>

                        <!-- Server Minecraft -->
            <div class="project-detail-card mc-card" data-aos="fade-up" data-aos-delay="300">
                <div class="mc-card-bg"></div>
                <div class="mc-card-content">
                    <div class="project-content" style="flex: 1;">
                        <h2>Server Minecraft</h2>
                        <p class="desc">Bermain bersama di dunia Minecraft lintas platform (Java & Bedrock). Server survival yang didukung oleh komunitas dengan fitur-fitur seru.</p>
                        
                        <div class="features-list">
                            <span class="feature"><i class="fas fa-check"></i> Cross-play (Java/Bedrock)</span>
                            <span class="feature"><i class="fas fa-check"></i> 24/7 Uptime</span>
                            <span class="feature"><i class="fas fa-check"></i> Economy System</span>
                        </div>
                        
                        <div class="project-links mt-3">
                            <a href="/status" class="btn btn-outline"><i class="fas fa-signal"></i> Status Server</a>
                        </div>
                    </div>
                    
                    <div class="mc-server-details">
                        <div class="mc-ip-box">
                            <span class="mc-platform">Java:</span>
                            <div class="mc-ip">mc.shiroko-project.my.id</div>
                        </div>
                        <div class="mc-ip-box mt-3">
                            <span class="mc-platform">Bedrock:</span>
                            <div class="mc-ip">mc.shiroko-project.my.id</div>
                            <div class="mc-port">Port: <span style="color:var(--accent-color);">25713</span></div>
                        </div>
                        <a href="minecraft://?addExternalServer=Shiroko%20Project|mc.shiroko-project.my.id:25713" class="btn btn-primary mt-4" style="width: 100%; justify-content: center;">
                            <i class="fas fa-gamepad"></i> Join Server
                        </a>
                    </div>
                </div>
            </div>

            <!-- Local AI WebUI -->
            <div class="project-detail-card" data-aos="fade-up" data-aos-delay="400">
                <div class="project-icon" style="color: #f39c12;"><i class="fas fa-laptop-code"></i></div>
                <div class="project-content">
                    <h2>Local AI WebUI</h2>
                    <p class="desc">Antarmuka web untuk mengakses berbagai model AI secara lokal maupun Cloud. Memudahkan pengguna berinteraksi tanpa harus via terminal.</p>
                    
                    <div class="features-list">
                        <span class="feature"><i class="fas fa-check"></i> Gemini API</span>
                        <span class="feature"><i class="fas fa-check"></i> Cloudflare Workers AI</span>
                        <span class="feature"><i class="fas fa-check"></i> Ollama (Local)</span>
                        <span class="feature"><i class="fas fa-check"></i> OpenRouter (Cloud)</span>
                        <span class="feature"><i class="fas fa-check"></i> Markdown Support</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.mb-5 { margin-bottom: 3rem; }
.mt-3 { margin-top: 1.5rem; }

.projects-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 900px;
    margin: 0 auto;
}

.project-detail-card {
    display: flex;
    gap: 2rem;
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 15px;
    padding: 2.5rem;
    transition: all 0.3s ease;
}

.project-detail-card:hover {
    border-color: var(--accent-color);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

.project-icon {
    font-size: 5rem;
    color: var(--accent-color);
    flex-shrink: 0;
    width: 100px;
    text-align: center;
}

.project-content h2 {
    font-size: 2rem;
    margin-bottom: 10px;
    color: var(--text-primary);
}

.desc {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
}

.features-list {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 1.5rem;
}

.feature {
    background: rgba(255,255,255,0.05);
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border-color);
}

.feature i {
    color: var(--accent-color);
}

.project-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

@media (max-width: 768px) {
    .project-detail-card {
        flex-direction: column;
        text-align: center;
    }
    .project-icon {
        margin: 0 auto;
    }
    .features-list {
        justify-content: center;
    }
    .project-links {
        justify-content: center;
    }
}
.mc-card {
    position: relative;
    overflow: hidden;
    padding: 0;
}
.mc-card-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/assets/img/mc-bg.jpeg');
    background-size: cover;
    background-position: left center;
    z-index: 0;
}
.mc-card-bg::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to right, transparent 0%, var(--surface-color) 70%, var(--surface-color) 100%);
}
.mc-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 2.5rem;
    width: 100%;
}
.mc-server-details {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.5rem;
    min-width: 280px;
    flex-shrink: 0;
    backdrop-filter: blur(10px);
}
.mc-ip-box {
    margin-bottom: 0.5rem;
}
.mc-platform {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: bold;
}
.mc-ip {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.15rem;
    color: #fff;
    margin-top: 4px;
    background: rgba(255,255,255,0.05);
    padding: 5px 10px;
    border-radius: 5px;
    border-left: 3px solid var(--accent-color);
}
.mc-port {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.95rem;
    color: #ccc;
    margin-top: 4px;
    padding-left: 10px;
}
@media (max-width: 768px) {
    .mc-card-bg::after {
        background: linear-gradient(to bottom, transparent 0%, var(--surface-color) 50%, var(--surface-color) 100%);
    }
    .mc-server-details {
        width: 100%;
    }
}
</style>

<%- include('partials/footer') %>

