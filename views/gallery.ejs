<%- include('partials/header') %>

<section class="section-padding" style="padding-top: 150px; min-height: 80vh;">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h1 class="glitch" data-text="Artwork & Gallery">Artwork & Gallery</h1>
            <p class="subtitle">Kumpulan gambar hasil generasi AI dari ekosistem Shiroko Project.</p>
        </div>

        <div class="gallery-grid">
            <% if (galleryData && galleryData.length > 0) { %>
                <% galleryData.forEach((item, index) => { %>
                    <div class="gallery-item" data-aos="zoom-in" data-aos-delay="<%= (index % 6) * 100 %>">
                        <img src="<%= item.url %>" alt="<%= item.title %>">
                        <div class="gallery-overlay">
                            <span><%= item.title %></span>
                            <small style="display:block; margin-top:5px; color:#aaa;"><%= item.tag %></small>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center w-100 py-5">
                    <i class="fas fa-images fa-3x" style="color: var(--text-secondary); margin-bottom:1rem;"></i>
                    <p style="color: var(--text-secondary);">Galeri masih kosong. Admin belum mengunggah gambar apa pun.</p>
                </div>
            <% } %>
        </div>
        
        <div class="text-center mt-5" data-aos="fade-up">
            <p style="color: var(--text-secondary); margin-bottom: 1rem;">Ingin melihat lebih banyak? Kunjungi repository kami.</p>
            <a href="https://github.com/ibnunurbarokah148-wq/bot-shiroko" target="_blank" class="btn btn-outline" style="display: inline-flex;">
                <i class="fab fa-github"></i> Buka GitHub
            </a>
        </div>
    </div>
</section>

<style>
.mb-5 { margin-bottom: 3rem; }
.mt-5 { margin-top: 3rem; }

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
}

.gallery-item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    border: 2px solid var(--border-color);
    transition: all 0.3s ease;
}

.gallery-item:hover {
    border-color: var(--accent-color);
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 176, 240, 0.3);
}

.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.gallery-item:hover img {
    transform: scale(1.1);
}

.gallery-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    transform: translateY(100%);
    transition: transform 0.3s ease;
    display: flex;
    align-items: flex-end;
}

.gallery-overlay span {
    color: #fff;
    font-weight: 600;
    font-size: 1.1rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
}

.gallery-item:hover .gallery-overlay {
    transform: translateY(0);
}
</style>

<%- include('partials/footer') %>
