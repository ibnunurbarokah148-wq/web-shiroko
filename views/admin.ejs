<%- include('partials/header') %>

<style>
    .admin-container {
        max-width: 1200px;
        margin: 0 auto;
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 2.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    
    .admin-login-box {
        max-width: 400px;
        margin: 0 auto;
        text-align: center;
    }

    .form-group {
        margin-bottom: 1.5rem;
        text-align: left;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--text-secondary);
    }

    .form-group input, .form-group select {
        width: 100%;
        padding: 0.8rem 1rem;
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        border-radius: 8px;
        font-family: inherit;
        font-size: 1rem;
    }

    .form-group input:focus, .form-group select:focus {
        outline: none;
        border-color: var(--accent-color);
    }

    .btn-submit {
        width: 100%;
        padding: 1rem;
        background: var(--accent-color);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        font-size: 1rem;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-submit:hover {
        background: var(--accent-hover);
    }

    .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        text-align: center;
    }
    .alert-error {
        background: rgba(248, 81, 73, 0.1);
        border: 1px solid var(--offline-color);
        color: var(--offline-color);
    }
    .alert-success {
        background: rgba(46, 160, 67, 0.1);
        border: 1px solid var(--online-color);
        color: var(--online-color);
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .btn-danger {
        background: var(--offline-color);
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 6px;
        color: white;
        cursor: pointer;
        font-weight: bold;
    }
    .btn-danger:hover {
        background: #d63c3c;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    @media (max-width: 900px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

    .panel-section {
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 1.5rem;
    }

    .panel-section h3 {
        margin-bottom: 1.5rem;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .service-status-list {
        list-style: none;
    }

    .service-status-list li {
        display: flex;
        justify-content: space-between;
        padding: 0.8rem 0;
        border-bottom: 1px solid var(--border-color);
    }
    .service-status-list li:last-child {
        border-bottom: none;
    }

    .badge-online {
        background: rgba(46, 160, 67, 0.2);
        color: var(--online-color);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .badge-offline {
        background: rgba(248, 81, 73, 0.2);
        color: var(--offline-color);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .control-buttons-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .control-card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 1.5rem;
        text-align: center;
        transition: 0.3s;
    }
    
    .control-card:hover {
        border-color: var(--accent-color);
    }

    .control-card i {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .control-card h4 {
        margin-bottom: 0.5rem;
    }

    .control-card p {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
        line-height: 1.4;
    }

    .btn-action {
        width: 100%;
        padding: 0.8rem;
        background: transparent;
        border: 1px solid var(--text-secondary);
        color: var(--text-primary);
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.3s;
    }

    .btn-action.comfy { border-color: #00b0f0; color: #00b0f0; }
    .btn-action.comfy:hover { background: rgba(0, 176, 240, 0.1); }
    
    .btn-action.git { border-color: #f05133; color: #f05133; }
    .btn-action.git:hover { background: rgba(240, 81, 51, 0.1); }

    .btn-action.restart { border-color: #d29922; color: #d29922; }
    .btn-action.restart:hover { background: rgba(210, 153, 34, 0.1); }

    .btn-action:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Pterodactyl Widget */
    .mc-stat-box {
        background: var(--surface-color);
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
        border: 1px solid var(--border-color);
    }
    .mc-stat-box .value {
        font-size: 1.8rem;
        font-weight: bold;
        color: var(--accent-color);
        margin: 0.5rem 0;
    }

    /* File Manager */
    .file-manager {
        background: var(--bg-color);
        border-radius: 8px;
        border: 1px solid var(--border-color);
        overflow: hidden;
    }
    .fm-header {
        background: var(--surface-color);
        padding: 1rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .fm-path {
        background: var(--bg-color);
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-family: monospace;
        flex-grow: 1;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
    }
    .fm-list {
        list-style: none;
        max-height: 400px;
        overflow-y: auto;
    }
    .fm-list li {
        padding: 0.8rem 1rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 1rem;
        cursor: pointer;
    }
    .fm-list li:hover {
        background: rgba(255,255,255,0.05);
    }
    .fm-list li i {
        font-size: 1.2rem;
        color: var(--text-secondary);
    }
    .fm-list li.directory i {
        color: #00b0f0;
    }
</style>

<section class="section-padding" style="padding-top: 150px; min-height: 80vh;">
<div class="container">
    <% if (!authenticated) { %>
        <div class="admin-container admin-login-box" data-aos="fade-up">
            <h2 style="margin-bottom: 1.5rem;"><i class="fas fa-lock"></i> Admin Login</h2>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
            <% } %>

            <form action="/admin/login" method="POST">
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required placeholder="Masukkan kata sandi...">
                </div>
                <button type="submit" class="btn-submit"><i class="fas fa-sign-in-alt"></i> Login</button>
            </form>
        </div>
    <% } else { %>
        <div class="admin-container" data-aos="fade-up">
            <div class="dashboard-header">
                <h2><i class="fas fa-cogs"></i> Ultimate Control Panel</h2>
                <form action="/admin/logout" method="POST">
                    <button type="submit" class="btn-danger"><i class="fas fa-sign-out-alt"></i> Logout</button>
                </form>
            </div>

            <div id="control-alert" style="display: none;" class="alert"></div>

            <div class="dashboard-grid">
                <!-- Kolom Kiri: Layanan & Minecraft -->
                <div>
                    <div class="panel-section" style="margin-bottom: 2rem;">
                        <h3><i class="fas fa-server"></i> Status Layanan Utama</h3>
                        <ul class="service-status-list">
                            <% data.services.forEach(service => { %>
                                <li>
                                    <span><i class="<%= service.icon %>" style="width: 25px;"></i> <%= service.name %></span>
                                    <% if (service.status === 'ONLINE') { %>
                                        <span class="badge-online">ONLINE</span>
                                    <% } else { %>
                                        <span class="badge-offline">OFFLINE</span>
                                    <% } %>
                                </li>
                            <% }) %>
                        </ul>
                    </div>

                    <div class="panel-section">
                        <h3><i class="fas fa-cube"></i> Minecraft Pterodactyl</h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                            <div class="mc-stat-box">
                                <p style="color:var(--text-secondary); font-size:0.9rem;">Status Node</p>
                                <div class="value" id="mc-status">...</div>
                            </div>
                            <div class="mc-stat-box">
                                <p style="color:var(--text-secondary); font-size:0.9rem;">Uptime</p>
                                <div class="value" id="mc-uptime" style="font-size: 1.2rem; margin-top:0.8rem;">...</div>
                            </div>
                            <div class="mc-stat-box">
                                <p style="color:var(--text-secondary); font-size:0.9rem;">Beban CPU</p>
                                <div class="value" id="mc-cpu">...</div>
                            </div>
                            <div class="mc-stat-box">
                                <p style="color:var(--text-secondary); font-size:0.9rem;">RAM / Ingatan</p>
                                <div class="value" id="mc-ram">...</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Kolom Kanan: Aksi Deploy -->
                <div class="panel-section">
                    <h3><i class="fas fa-terminal"></i> Auto-Deploy & Remote Control</h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
                        Kirim perintah pull & restart langsung ke server VPS secara otomatis.
                    </p>

                    <div class="control-buttons-grid">
                        <div class="control-card">
                            <i class="fab fa-github" style="color: #f05133;"></i>
                            <h4>Deploy Web</h4>
                            <p>Git pull repo web dan restart PM2 web-shiroko.</p>
                            <button class="btn-action git" onclick="sendDeploy('web', this)">
                                <i class="fas fa-rocket"></i> Jalankan
                            </button>
                        </div>

                        <div class="control-card">
                            <i class="fab fa-github" style="color: #f05133;"></i>
                            <h4>Deploy Bot</h4>
                            <p>Git pull repo bot dan restart PM2 shiroko.</p>
                            <button class="btn-action git" onclick="sendDeploy('bot', this)">
                                <i class="fas fa-rocket"></i> Jalankan
                            </button>
                        </div>
                        
                        <div class="control-card" style="grid-column: span 2;">
                            <i class="fas fa-palette" style="color: #00b0f0;"></i>
                            <h4>Toggle ComfyUI</h4>
                            <p>Matikan/Nyalakan akses pengguna WA ke mesin render GPU Vast.ai</p>
                            <button class="btn-action comfy" onclick="sendControl('toggle_comfyui', this)">
                                <i class="fas fa-power-off"></i> Eksekusi
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-grid">
                <!-- Gallery Manager -->
                <div class="panel-section">
                    <h3><i class="fas fa-images"></i> Manajemen Galeri</h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
                        Unggah gambar hasil generasi AI ke galeri publik.
                    </p>
                    <form id="gallery-form" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>File Gambar</label>
                            <input type="file" name="image" accept="image/*" required>
                        </div>
                        <div class="form-group">
                            <label>Judul Gambar</label>
                            <input type="text" name="title" placeholder="Contoh: Arisu Maid" required>
                        </div>
                        <div class="form-group">
                            <label>Kategori (Tag)</label>
                            <select name="tag">
                                <option value="Artwork">Artwork</option>
                                <option value="Landscape">Landscape</option>
                                <option value="Character Design">Character Design</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-submit" id="btn-upload"><i class="fas fa-upload"></i> Unggah ke Galeri</button>
                    </form>
                </div>

                <!-- File Manager -->
                <div class="panel-section">
                    <h3><i class="fas fa-folder-open"></i> File Manager VPS</h3>
                    <div class="file-manager">
                        <div class="fm-header">
                            <button onclick="goUp()" class="btn-action" style="width: auto; padding: 0.5rem 1rem;"><i class="fas fa-level-up-alt"></i></button>
                            <div class="fm-path" id="fm-current-path">/root</div>
                        </div>
                        <ul class="fm-list" id="fm-list">
                            <!-- Injected by JS -->
                            <li style="text-align:center; display:block;"><i class="fas fa-spinner fa-spin"></i> Loading...</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function showAlert(type, icon, message) {
                const alertBox = document.getElementById('control-alert');
                alertBox.className = 'alert alert-' + type;
                alertBox.innerHTML = `<i class="fas ${icon}"></i> ` + message;
                alertBox.style.display = 'block';
            }

            // Remote Control (Toggle ComfyUI)
            async function sendControl(action, btnElement) {
                const originalHtml = btnElement.innerHTML;
                btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                btnElement.disabled = true;

                try {
                    const res = await fetch('/admin/api/control', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action })
                    });
                    const data = await res.json();
                    if(data.status === 'ok') showAlert('success', 'fa-check-circle', data.message);
                    else showAlert('error', 'fa-exclamation-triangle', data.message);
                } catch (err) {
                    showAlert('error', 'fa-wifi', 'Koneksi gagal.');
                } finally {
                    btnElement.innerHTML = originalHtml;
                    btnElement.disabled = false;
                }
            }

            // Deploy Command
            async function sendDeploy(target, btnElement) {
                if(!confirm(`Yakin ingin melakukan git pull dan pm2 restart pada ${target}?`)) return;
                
                const originalHtml = btnElement.innerHTML;
                btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                btnElement.disabled = true;

                try {
                    const res = await fetch('/admin/api/deploy', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ target })
                    });
                    const data = await res.json();
                    if(data.status === 'ok') {
                        showAlert('success', 'fa-check-circle', data.message);
                        if(target === 'web') {
                            setTimeout(() => location.reload(), 6000);
                        }
                    }
                    else showAlert('error', 'fa-exclamation-triangle', data.message);
                } catch (err) {
                    showAlert('error', 'fa-wifi', 'Deployment diinisiasi (koneksi terputus dari web server).');
                    setTimeout(() => location.reload(), 6000);
                } finally {
                    btnElement.innerHTML = originalHtml;
                    btnElement.disabled = false;
                }
            }

            // Gallery Upload
            document.getElementById('gallery-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('btn-upload');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengunggah...';
                btn.disabled = true;

                const formData = new FormData(e.target);
                try {
                    const res = await fetch('/admin/api/gallery', { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.status === 'ok') {
                        showAlert('success', 'fa-check-circle', 'Gambar berhasil ditambahkan ke galeri!');
                        e.target.reset();
                    } else {
                        showAlert('error', 'fa-exclamation-circle', data.error || 'Gagal unggah.');
                    }
                } catch (err) {
                    showAlert('error', 'fa-wifi', 'Koneksi terputus.');
                } finally {
                    btn.innerHTML = '<i class="fas fa-upload"></i> Unggah ke Galeri';
                    btn.disabled = false;
                }
            });

            // Minecraft Status Fetcher
            async function fetchMCStatus() {
                try {
                    const res = await fetch('/admin/api/pterodactyl');
                    if(res.ok) {
                        const data = await res.json();
                        const attr = data.attributes;
                        document.getElementById('mc-status').innerText = attr.current_state.toUpperCase();
                        document.getElementById('mc-status').style.color = attr.current_state === 'running' ? 'var(--online-color)' : 'var(--offline-color)';
                        
                        document.getElementById('mc-cpu').innerText = attr.resources.cpu_absolute.toFixed(2) + '%';
                        document.getElementById('mc-ram').innerText = (attr.resources.memory_bytes / 1024 / 1024).toFixed(0) + ' MB';
                        
                        const uptimeSec = attr.resources.uptime / 1000;
                        const hours = Math.floor(uptimeSec / 3600);
                        const mins = Math.floor((uptimeSec % 3600) / 60);
                        document.getElementById('mc-uptime').innerText = `${hours}h ${mins}m`;
                    }
                } catch(e) {
                    document.getElementById('mc-status').innerText = 'ERROR';
                }
            }
            fetchMCStatus();
            setInterval(fetchMCStatus, 5000); // Polling tiap 5 detik

            // File Manager logic
            let currentFmPath = '/root';
            async function loadFiles(dir) {
                const list = document.getElementById('fm-list');
                list.innerHTML = '<li style="text-align:center; display:block;"><i class="fas fa-spinner fa-spin"></i> Loading...</li>';
                try {
                    const res = await fetch('/admin/api/files?dir=' + encodeURIComponent(dir));
                    if(res.ok) {
                        const data = await res.json();
                        currentFmPath = data.currentDir;
                        document.getElementById('fm-current-path').innerText = currentFmPath;
                        list.innerHTML = '';
                        
                        data.files.forEach(f => {
                            const li = document.createElement('li');
                            li.className = f.isDirectory ? 'directory' : 'file';
                            li.innerHTML = `<i class="fas ${f.isDirectory ? 'fa-folder' : 'fa-file-alt'}"></i> <span>${f.name}</span>`;
                            if(f.isDirectory) {
                                li.onclick = () => loadFiles(f.path);
                            }
                            list.appendChild(li);
                        });
                    } else {
                        const data = await res.json();
                        list.innerHTML = `<li style="text-align:center; display:block; color:var(--offline-color);"><i class="fas fa-exclamation-triangle"></i> ${data.error || 'Gagal memuat.'} (Mungkin karena jalan di komputer lokal Windows yang tidak memiliki folder /root)</li>`;
                    }
                } catch(e) {
                    list.innerHTML = `<li style="text-align:center; display:block; color:var(--offline-color);"><i class="fas fa-wifi"></i> Error koneksi.</li>`;
                    console.error(e);
                }
            }
            function goUp() {
                if(currentFmPath === '/root' || currentFmPath === '/root/') return;
                const parts = currentFmPath.split('/');
                parts.pop();
                const upPath = parts.join('/') || '/';
                loadFiles(upPath);
            }
            loadFiles(currentFmPath);

        </script>
    <% } %>
</div>
</section>

<%- include('partials/footer') %>
