<% if (!authenticated) { %>
    <%- include('partials/header') %>
    <style>
        .login-wrapper { display: flex; justify-content: center; padding-top: 150px; min-height: 80vh; }
        .admin-login-box { width: 100%; max-width: 400px; background: var(--surface-color); padding: 2.5rem; border-radius: 12px; border: 1px solid var(--border-color); box-shadow: 0 10px 30px rgba(0,0,0,0.5); text-align: center; }
        .form-group { margin-bottom: 1.5rem; text-align: left; }
        .form-group label { display: block; margin-bottom: 0.5rem; color: var(--text-secondary); }
        .form-group input { width: 100%; padding: 0.8rem 1rem; background: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 8px; font-family: inherit; }
        .btn-submit { width: 100%; padding: 1rem; background: var(--accent-color); color: #fff; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }
    </style>
    <div class="login-wrapper">
        <div class="admin-login-box">
            <h2 style="margin-bottom: 1.5rem;"><i class="fas fa-lock"></i> Admin Login</h2>
            <% if (typeof error !== 'undefined' && error) { %>
                <div style="background: rgba(248, 81, 73, 0.1); border: 1px solid #f85149; color: #f85149; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;"><%= error %></div>
            <% } %>
            <form action="/admin/login" method="POST">
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" required>
                </div>
                <button type="submit" class="btn-submit">Login</button>
            </form>
        </div>
    </div>
    <%- include('partials/footer') %>
<% } else { %>
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control Panel - Shiroko</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
    <style>
        :root {
            --bg-color: #0f1115;
            --sidebar-bg: #1e2128;
            --surface-hover: #2a2e37;
            --text-primary: #e2e8f0;
            --text-secondary: #94a3b8;
            --accent-color: #3b82f6;
            --border-color: #2d313a;
            --danger-color: #ef4444;
        }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; font-family: 'Inter', sans-serif; background: var(--bg-color); color: var(--text-primary); display: flex; height: 100vh; overflow: hidden; }
        
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-color); }
        ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-secondary); }

        .sidebar { width: 250px; background: var(--sidebar-bg); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; flex-shrink: 0; }
        .sidebar-logo { padding: 1.5rem; font-size: 1.2rem; font-weight: bold; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.75rem; }
        .sidebar-logo i { font-size: 1.5rem; color: var(--accent-color); }
        .sidebar-nav { flex-grow: 1; padding: 1rem 0; overflow-y: auto; list-style: none; margin: 0; }
        .nav-category { font-size: 0.7rem; text-transform: uppercase; color: var(--text-secondary); padding: 0.5rem 1.5rem; letter-spacing: 1px; margin-top: 0.5rem; }
        .sidebar-nav li { padding: 0.75rem 1.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.75rem; color: var(--text-secondary); transition: 0.2s; border-left: 3px solid transparent; }
        .sidebar-nav li:hover { background: var(--surface-hover); color: var(--text-primary); }
        .sidebar-nav li.active { color: var(--text-primary); background: rgba(59, 130, 246, 0.1); border-left-color: var(--accent-color); }
        
        .main-content { flex-grow: 1; display: flex; flex-direction: column; overflow: hidden; position: relative; }
        .topbar { background: var(--bg-color); padding: 1rem 2rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; }
        .server-title { font-size: 1.2rem; font-weight: bold; }
        
        .content-area { flex-grow: 1; overflow-y: auto; padding: 2rem; }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.2s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .panel-card { background: var(--sidebar-bg); border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 1.5rem; overflow: hidden; }
        .panel-header { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color); background: rgba(0,0,0,0.2); font-weight: bold; display: flex; align-items: center; gap: 0.5rem; }
        .panel-body { padding: 1.5rem; }

        .btn { background: var(--surface-hover); color: var(--text-primary); border: 1px solid var(--border-color); padding: 0.5rem 1rem; border-radius: 5px; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem; font-family: inherit; transition: 0.2s; }
        .btn:hover { background: var(--border-color); }
        .btn-primary { background: var(--accent-color); border-color: var(--accent-color); }
        .btn-primary:hover { background: #2563eb; }
        .btn-danger { background: rgba(239, 68, 68, 0.1); color: var(--danger-color); border-color: rgba(239, 68, 68, 0.2); }
        .btn-danger:hover { background: rgba(239, 68, 68, 0.2); }

        /* Form UI */
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.5rem; color: var(--text-secondary); font-size: 0.9rem; }
        .form-group input, .form-group select { width: 100%; background: var(--bg-color); border: 1px solid var(--border-color); color: white; padding: 0.75rem; border-radius: 5px; }
        .form-group input:focus { outline: none; border-color: var(--accent-color); }

        /* Status Colors */
        .status-online { color: #22c55e; font-weight: bold; }
        .status-offline { color: #ef4444; font-weight: bold; }

        /* File Manager */
        .fm-toolbar { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
        .fm-path-bar { background: var(--sidebar-bg); border: 1px solid var(--border-color); padding: 0.75rem 1rem; border-radius: 5px; margin-bottom: 1rem; font-family: monospace; display: flex; gap: 0.5rem; align-items: center; }
        table.fm-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
        .fm-table th, .fm-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color); }
        .fm-table th { color: var(--text-secondary); text-transform: uppercase; font-size: 0.75rem; }
        .fm-table tr:hover { background: rgba(255,255,255,0.02); }
        .fm-table td i { width: 20px; text-align: center; color: var(--text-secondary); font-size: 1.1rem; }
        .fm-table td i.fa-folder { color: #eab308; }
        .fm-actions button { background: transparent; border: none; color: var(--text-secondary); cursor: pointer; padding: 0.25rem 0.5rem; border-radius: 3px; }
        .fm-actions button:hover { color: var(--text-primary); background: var(--surface-hover); }

        /* Code Editor */
        #editor-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-color); z-index: 1000; display: none; flex-direction: column; }
        .editor-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--sidebar-bg); border-bottom: 1px solid var(--border-color); }
        #monaco-container { flex-grow: 1; }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
        .sys-stat-box { text-align: center; }
        .sys-stat-box .value { font-size: 1.8rem; font-weight: bold; color: var(--accent-color); margin-top: 0.5rem; }
        .log-viewer { background: #000; color: #0f0; font-family: monospace; padding: 1rem; border-radius: 5px; height: 300px; overflow-y: auto; font-size: 0.85rem; white-space: pre-wrap; }

        @media (max-width: 768px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; flex-direction: row; align-items: center; border-right: none; border-bottom: 1px solid var(--border-color); padding: 0.5rem; overflow-x: auto; }
            .sidebar-logo { border: none; padding: 0.5rem; }
            .sidebar-nav { display: flex; padding: 0; overflow-y: visible; }
            .nav-category { display: none; }
            .sidebar-nav li { padding: 0.5rem; border-left: none; border-bottom: 3px solid transparent; white-space: nowrap; }
            .sidebar-nav li.active { border-left: none; border-bottom-color: var(--accent-color); }
            .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <i class="fas fa-cube"></i> Shiroko Panel
        </div>
        <ul class="sidebar-nav">
            <div class="nav-category">Kontrol</div>
            <li class="active" onclick="switchTab('tab-dashboard', this)"><i class="fas fa-terminal"></i> Konsol</li>
            <li onclick="switchTab('tab-files', this)"><i class="fas fa-folder"></i> File Manager</li>
            
            <div class="nav-category">Manajemen</div>
            <li onclick="switchTab('tab-remote', this)"><i class="fas fa-rocket"></i> Deploy & Power</li>
            <li onclick="switchTab('tab-gallery', this)"><i class="fas fa-images"></i> Galeri</li>
            
            <div class="nav-category">Administrasi</div>
            <li onclick="switchTab('tab-system', this)"><i class="fas fa-server"></i> Metrik Sistem</li>
        </ul>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div class="server-title">Web & Bot Server</div>
            <div style="display: flex; gap: 1rem;">
                <button class="btn btn-primary" onclick="window.open('/', '_blank')"><i class="fas fa-globe"></i> Lihat Web</button>
                <form action="/admin/logout" method="POST" style="margin:0;">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-power-off"></i> Logout</button>
                </form>
            </div>
        </header>

        <div class="content-area">
            <!-- Alert -->
            <div id="control-alert" style="display:none; padding: 1rem; border-radius: 5px; margin-bottom: 1rem;"></div>

            <!-- TAB 1: KONSOL -->
            <div id="tab-dashboard" class="tab-content active">
                <div class="grid-3" style="margin-bottom: 1.5rem;">
                    <div class="panel-card sys-stat-box">
                        <div class="panel-header"><i class="fas fa-comment-dots"></i> Total Chat</div>
                        <div class="value" id="stat-totalChat"><%= data.stats ? data.stats.totalChat : 0 %></div>
                    </div>
                    <div class="panel-card sys-stat-box">
                        <div class="panel-header"><i class="fas fa-images"></i> Image Generated</div>
                        <div class="value" id="stat-imageGenerated"><%= data.stats ? data.stats.imageGenerated : 0 %></div>
                    </div>
                    <div class="panel-card sys-stat-box">
                        <div class="panel-header"><i class="fab fa-whatsapp"></i> WA Users</div>
                        <div class="value" id="stat-whatsappUsers"><%= data.stats ? data.stats.whatsappUsers : 0 %></div>
                    </div>
                    <div class="panel-card sys-stat-box">
                        <div class="panel-header"><i class="fab fa-discord"></i> DC Users</div>
                        <div class="value" id="stat-discordUsers"><%= data.stats ? data.stats.discordUsers : 0 %></div>
                    </div>
                    <div class="panel-card sys-stat-box">
                        <div class="panel-header"><i class="fas fa-robot"></i> AI Requests</div>
                        <div class="value" id="stat-aiRequests"><%= data.stats ? data.stats.aiRequests : 0 %></div>
                    </div>
                    <div class="panel-card sys-stat-box">
                        <div class="panel-header"><i class="fas fa-terminal"></i> Total Commands</div>
                        <div class="value" id="stat-commands"><%= data.stats ? data.stats.commands : 0 %></div>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="panel-card">
                        <div class="panel-header"><i class="fas fa-chart-line"></i> Resource Usage</div>
                        <div class="panel-body">
                            <canvas id="mcChart" style="width:100%; height:200px;"></canvas>
                        </div>
                    </div>
                    <div class="panel-card">
                        <div class="panel-header"><i class="fas fa-network-wired"></i> Status Layanan</div>
                        <div class="panel-body" style="padding: 0;">
                            <table class="fm-table">
                                <% data.services.forEach(service => { %>
                                    <tr>
                                        <td><i class="<%= service.icon %>"></i> <%= service.name %></td>
                                        <td style="text-align: right;">
                                            <span class="<%= service.status === 'ONLINE' ? 'status-online' : 'status-offline' %>"><%= service.status %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: FILE MANAGER -->
            <div id="tab-files" class="tab-content">
                <div class="panel-card">
                    <div class="panel-body">
                        <div class="fm-path-bar">
                            <button class="btn" onclick="goUp()"><i class="fas fa-level-up-alt"></i></button>
                            <span id="fm-current-path">/root</span>
                        </div>
                        
                        <div class="fm-toolbar">
                            <input type="file" id="fm-upload" style="display:none;" onchange="uploadFile(this)">
                            <button class="btn" onclick="document.getElementById('fm-upload').click()"><i class="fas fa-upload"></i> Upload</button>
                            <button class="btn" onclick="createItem('file')"><i class="fas fa-file-medical"></i> New File</button>
                            <button class="btn" onclick="createItem('folder')"><i class="fas fa-folder-plus"></i> New Folder</button>
                            <button class="btn" onclick="loadFiles(currentFmPath)"><i class="fas fa-sync-alt"></i> Refresh</button>
                            <button class="btn btn-primary" id="btn-paste" style="display:none;" onclick="pasteFile()"><i class="fas fa-paste"></i> Paste</button>
                        </div>

                        <table class="fm-table">
                            <thead>
                                <tr>
                                    <th style="width: 50%;">Nama</th>
                                    <th>Ukuran</th>
                                    <th>Terakhir Diubah</th>
                                    <th style="text-align: right;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="fm-list">
                                <tr><td colspan="4" style="text-align:center;">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 3: DEPLOY & POWER -->
            <div id="tab-remote" class="tab-content">
                <div class="grid-2">
                    <div class="panel-card">
                        <div class="panel-header"><i class="fas fa-rocket"></i> Deployment Commands</div>
                        <div class="panel-body">
                            <button class="btn" style="width:100%; margin-bottom:1rem;" onclick="sendDeploy('web', this)"><i class="fab fa-github"></i> Deploy Web (Git Pull)</button>
                            <button class="btn" style="width:100%; margin-bottom:1rem;" onclick="sendDeploy('bot', this)"><i class="fab fa-github"></i> Deploy Bot (Git Pull)</button>
                            <button class="btn" style="width:100%;" onclick="sendControl('toggle_comfyui', this)"><i class="fas fa-palette"></i> Toggle ComfyUI</button>
                        </div>
                    </div>
                    <div class="panel-card" style="border-color: rgba(239, 68, 68, 0.3);">
                        <div class="panel-header" style="color: var(--danger-color);"><i class="fas fa-skull-crossbones"></i> Danger Zone</div>
                        <div class="panel-body">
                            <p style="color: var(--text-secondary); margin-bottom: 1rem; font-size: 0.9rem;">Tindakan ini akan melakukan hard reset ke OS VPS.</p>
                            <button class="btn btn-danger" style="width:100%;" onclick="rebootVPS(this)"><i class="fas fa-power-off"></i> Reboot VPS</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 4: GALERI -->
            <div id="tab-gallery" class="tab-content">
                <div class="grid-2">
                    <div class="panel-card" style="max-height: 450px;">
                        <div class="panel-header"><i class="fas fa-upload"></i> Tambah Galeri</div>
                        <div class="panel-body">
                            <form id="gallery-form" enctype="multipart/form-data">
                                <div class="form-group">
                                    <label>File Gambar</label>
                                    <input type="file" name="image" accept="image/*" required>
                                </div>
                                <div class="form-group">
                                    <label>Judul</label>
                                    <input type="text" name="title" required>
                                </div>
                                <div class="form-group">
                                    <label>Kategori</label>
                                    <select name="tag">
                                        <option value="Artwork">Artwork</option>
                                        <option value="Landscape">Landscape</option>
                                        <option value="Character Design">Character Design</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-primary" style="width:100%;" id="btn-upload">Unggah</button>
                            </form>
                        </div>
                    </div>

                    <div class="panel-card">
                        <div class="panel-header"><i class="fas fa-images"></i> Daftar Galeri</div>
                        <div class="panel-body" style="max-height: 500px; overflow-y: auto;">
                            <div id="gallery-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem;">
                                <!-- Gallery items will be loaded here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 5: SISTEM -->
            <div id="tab-system" class="tab-content">
                <div class="grid-4" style="margin-bottom: 1.5rem;">
                    <div class="panel-card"><div class="panel-body sys-stat-box"><p>CPU Usage</p><div class="value" id="sys-cpu">-</div></div></div>
                    <div class="panel-card"><div class="panel-body sys-stat-box"><p>RAM Usage</p><div class="value" id="sys-ram">-</div></div></div>
                    <div class="panel-card"><div class="panel-body sys-stat-box"><p>Storage</p><div class="value" id="sys-disk" style="font-size: 1.2rem;">-</div></div></div>
                    <div class="panel-card"><div class="panel-body sys-stat-box"><p>Uptime</p><div class="value" id="sys-uptime">-</div></div></div>
                </div>
                <div class="panel-card">
                    <div class="panel-header">
                        <i class="fas fa-terminal"></i> PM2 Logs
                        <div style="margin-left: auto; display: flex; gap: 0.5rem;">
                            <button class="btn" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;" onclick="fetchLogs('web')">Web</button>
                            <button class="btn" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;" onclick="fetchLogs('bot')">Bot</button>
                        </div>
                    </div>
                    <div class="panel-body"><div class="log-viewer" id="log-viewer">...</div></div>
                </div>
            </div>
        </div>
    </main>

    <!-- Editor Overlay -->
    <div id="editor-overlay">
        <div class="editor-header">
            <div>
                <span id="editor-filename" style="font-weight: bold; margin-right: 1rem;">file.txt</span>
                <span id="editor-status" style="color: var(--text-secondary); font-size: 0.85rem;"></span>
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button class="btn btn-primary" id="editor-save-btn" onclick="saveFile()"><i class="fas fa-save"></i> Save</button>
                <button class="btn" onclick="closeEditor()"><i class="fas fa-times"></i> Close</button>
            </div>
        </div>
        <div id="monaco-container"></div>
        <div id="image-preview-container" style="display:none; padding:2rem; text-align:center; flex-grow:1; align-items:center; justify-content:center;">
            <img id="image-preview-img" style="max-width:100%; max-height:70vh; border-radius:8px; border:1px solid #333;">
        </div>
    </div>
</body>
<script>
    // GLOBAL VARS & SETUP
    let currentFmPath = '/root';
    let editorInstance = null;
    let editingFilePath = '';
    let fmClipboard = null;

    // Tab Switcher
    function switchTab(tabId, element) {
        document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
        document.querySelectorAll('.sidebar-nav li').forEach(li => li.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');
        element.classList.add('active');
    }

    // Alert
    function showAlert(message, isError = false) {
        const box = document.getElementById('control-alert');
        box.style.display = 'block';
        box.style.background = isError ? 'rgba(239, 68, 68, 0.1)' : 'rgba(34, 197, 94, 0.1)';
        box.style.color = isError ? '#ef4444' : '#22c55e';
        box.style.border = `1px solid ${isError ? '#ef4444' : '#22c55e'}`;
        box.innerHTML = `<i class="fas ${isError ? 'fa-exclamation-triangle' : 'fa-check-circle'}"></i> ${message}`;
        setTimeout(() => box.style.display = 'none', 5000);
    }

    // ================== FILE MANAGER ==================
    async function loadFiles(dir) {
        const list = document.getElementById('fm-list');
        list.innerHTML = '<tr><td colspan="4" style="text-align:center;"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>';
        try {
            const res = await fetch('/admin/api/files?dir=' + encodeURIComponent(dir));
            const data = await res.json();
            if(!res.ok) throw new Error(data.error);
            
            currentFmPath = data.currentDir;
            document.getElementById('fm-current-path').innerText = currentFmPath;
            list.innerHTML = '';
            
            data.files.forEach(f => {
                const tr = document.createElement('tr');
                const sizeStr = f.isDirectory ? '-' : (f.size / 1024).toFixed(1) + ' KB';
                const dateStr = new Date(f.mtime).toLocaleString();
                const icon = f.isDirectory ? 'fa-folder' : 'fa-file-alt';
                
                tr.innerHTML = `
                    <td>
                        <div style="display:flex; align-items:center; gap:0.5rem; cursor:${f.isDirectory ? 'pointer' : 'default'}" 
                             onclick="${f.isDirectory ? `loadFiles('${f.path}')` : ''}">
                            <i class="fas ${icon}"></i> <span>${f.name}</span>
                        </div>
                    </td>
                    <td>${sizeStr}</td>
                    <td>${dateStr}</td>
                    <td class="fm-actions" style="text-align:right;">
                        ${!f.isDirectory ? `<button title="Edit" onclick="openEditor('${f.path}')"><i class="fas fa-edit"></i></button>` : ''}
                        <button title="Rename" onclick="fileAction('rename', '${f.path}')"><i class="fas fa-pencil-alt"></i></button>
                        <button title="Copy" onclick="fileAction('copy', '${f.path}')"><i class="fas fa-copy"></i></button>
                        <button title="Move" onclick="fileAction('move', '${f.path}')"><i class="fas fa-arrows-alt"></i></button>
                        <button title="Delete" style="color:var(--danger-color)" onclick="fileAction('delete', '${f.path}')"><i class="fas fa-trash"></i></button>
                    </td>
                `;
                list.appendChild(tr);
            });
        } catch(e) {
            list.innerHTML = `<tr><td colspan="4" style="text-align:center; color:var(--danger-color);"><i class="fas fa-exclamation-triangle"></i> ${e.message}</td></tr>`;
        }
    }
    
    function goUp() {
        if(currentFmPath === '/root' || currentFmPath === '/root/') return;
        const parts = currentFmPath.split('/'); parts.pop();
        loadFiles(parts.join('/') || '/');
    }

    async function fileAction(action, item) {
        if(action === 'delete') {
            if(!confirm(`Hapus ${item}?`)) return;
        }
        
        let dest = '', newName = '';
        if(action === 'rename') {
            newName = prompt('Nama baru:', item.split('/').pop());
            if(!newName) return;
        } else if(action === 'copy' || action === 'move') {
            fmClipboard = { action, source: item };
            document.getElementById('btn-paste').style.display = 'inline-block';
            showAlert((action === 'copy' ? 'Disalin' : 'Dipotong') + '! Buka folder tujuan lalu klik Paste.');
            return;
        }

        try {
            const res = await fetch('/admin/api/files/action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action, source: item, dest, newName })
            });
            if(res.ok) {
                showAlert('Berhasil!');
                loadFiles(currentFmPath);
            } else showAlert('Gagal', true);
        } catch(e) { showAlert(e.message, true); }
    }

    async function pasteFile() {
        if(!fmClipboard) return;
        const dest = currentFmPath + '/' + fmClipboard.source.split('/').pop();
        try {
            const res = await fetch('/admin/api/files/action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: fmClipboard.action, source: fmClipboard.source, dest: dest })
            });
            if(res.ok) {
                showAlert('Berhasil ditempel!');
                fmClipboard = null;
                document.getElementById('btn-paste').style.display = 'none';
                loadFiles(currentFmPath);
            } else showAlert('Gagal menempel', true);
        } catch(e) { showAlert(e.message, true); }
    }

    async function createItem(type) {
        const name = prompt(`Nama ${type} baru:`);
        if(!name) return;
        try {
            const res = await fetch('/admin/api/files/action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'create', source: currentFmPath + '/' + name, type })
            });
            if(res.ok) {
                showAlert('Berhasil dibuat!');
                loadFiles(currentFmPath);
            } else showAlert('Gagal', true);
        } catch(e) { showAlert(e.message, true); }
    }

    async function uploadFile(input) {
        if(!input.files.length) return;
        const formData = new FormData();
        formData.append('file', input.files[0]);
        formData.append('dir', currentFmPath);
        try {
            const res = await fetch('/admin/api/files/upload', { method: 'POST', body: formData });
            if(!res.ok) throw new Error('Upload failed');
            loadFiles(currentFmPath);
            showAlert('Upload berhasil!');
        } catch(e) { showAlert(e.message, true); }
        input.value = ''; // reset
    }

    // ================== CODE EDITOR ==================
    require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs' }});
    function initMonaco(content, ext) {
        let lang = 'plaintext';
        if(ext === 'js') lang = 'javascript';
        if(ext === 'json') lang = 'json';
        if(ext === 'html' || ext === 'ejs') lang = 'html';
        if(ext === 'css') lang = 'css';
        
        if (editorInstance) {
            editorInstance.setValue(content);
            monaco.editor.setModelLanguage(editorInstance.getModel(), lang);
        } else {
            require(['vs/editor/editor.main'], function () {
                editorInstance = monaco.editor.create(document.getElementById('monaco-container'), {
                    value: content,
                    language: lang,
                    theme: 'vs-dark',
                    automaticLayout: true
                });
            });
        }
    }

    async function openEditor(filePath) {
        document.getElementById('editor-status').innerText = 'Loading...';
        document.getElementById('editor-overlay').style.display = 'flex';
        document.getElementById('editor-filename').innerText = filePath;
        editingFilePath = filePath;

        const ext = filePath.split('.').pop().toLowerCase();
        if(['png','jpg','jpeg','gif','webp', 'ico'].includes(ext)) {
            document.getElementById('monaco-container').style.display = 'none';
            document.getElementById('image-preview-container').style.display = 'flex';
            document.getElementById('image-preview-img').src = '/admin/api/files/download?dir=' + encodeURIComponent(filePath) + '&t=' + Date.now();
            document.getElementById('editor-save-btn').style.display = 'none';
            document.getElementById('editor-status').innerText = 'Image Preview';
            return;
        }

        document.getElementById('monaco-container').style.display = 'block';
        document.getElementById('image-preview-container').style.display = 'none';
        document.getElementById('editor-save-btn').style.display = 'inline-flex';

        try {
            const res = await fetch('/admin/api/files/read?dir=' + encodeURIComponent(filePath));
            const data = await res.json();
            if(!res.ok) throw new Error(data.error);
            
            initMonaco(data.content, ext);
            document.getElementById('editor-status').innerText = 'Ready';
        } catch(e) {
            document.getElementById('editor-status').innerText = 'Error: ' + e.message;
        }
    }

    function closeEditor() {
        document.getElementById('editor-overlay').style.display = 'none';
        editingFilePath = '';
    }

    async function saveFile() {
        if(!editingFilePath || !editorInstance) return;
        document.getElementById('editor-status').innerText = 'Saving...';
        try {
            const content = editorInstance.getValue();
            const res = await fetch('/admin/api/files/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ dir: editingFilePath, content })
            });
            if(!res.ok) throw new Error('Save failed');
            document.getElementById('editor-status').innerText = 'Saved!';
            setTimeout(() => document.getElementById('editor-status').innerText = '', 2000);
        } catch(e) {
            document.getElementById('editor-status').innerText = 'Error: ' + e.message;
        }
    }

    // ================== OTHER PANELS ==================
    async function sendControl(action, btn) {
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; btn.disabled = true;
        try {
            const res = await fetch('/admin/api/control', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({action}) });
            const data = await res.json();
            showAlert(data.message, res.status !== 200);
        } catch(e) { showAlert('Error', true); }
        btn.innerHTML = 'Toggle'; btn.disabled = false;
    }

    async function sendDeploy(target, btn) {
        if(!confirm('Deploy ' + target + '?')) return;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; btn.disabled = true;
        try {
            const res = await fetch('/admin/api/deploy', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({target}) });
            const data = await res.json();
            showAlert(data.message, res.status !== 200);
        } catch(e) { showAlert('Deployment triggered (disconnected)', false); }
        btn.innerHTML = 'Deploy ' + target; btn.disabled = false;
    }

    async function rebootVPS() {
        if(!confirm('Reboot VPS?')) return;
        try {
            await fetch('/admin/api/reboot', { method: 'POST' });
            showAlert('Rebooting...');
        } catch(e) { showAlert('Rebooting (disconnected)'); }
    }

    // Pterodactyl Chart
    let mcChart;
    function initChart() {
        const ctx = document.getElementById('mcChart').getContext('2d');
        mcChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: Array(10).fill(''),
                datasets: [
                    { label: 'CPU (%)', data: Array(10).fill(0), borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.2)', fill: true, tension: 0.4 },
                    { label: 'RAM (MB)', data: Array(10).fill(0), borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.2)', fill: true, tension: 0.4 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false, animation: { duration: 0 },
                scales: { y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.1)' } }, x: { grid: { display: false } } },
                plugins: { legend: { labels: { color: '#94a3b8' } } }
            }
        });
    }
    initChart();
    
    async function fetchSystemStats() {
        try {
            const resPtero = await fetch('/admin/api/pterodactyl');
            if(resPtero.ok) {
                const data = await resPtero.json();
                mcChart.data.datasets[0].data.push(data.attributes.resources.cpu_absolute); mcChart.data.datasets[0].data.shift();
                mcChart.data.datasets[1].data.push(data.attributes.resources.memory_bytes/1024/1024); mcChart.data.datasets[1].data.shift();
                mcChart.update();
            }
            const resVps = await fetch('/admin/api/vps-stats');
            if(resVps.ok) {
                const vps = await resVps.json();
                document.getElementById('sys-cpu').innerText = vps.cpu + '%';
                document.getElementById('sys-ram').innerText = vps.ram + '%';
                document.getElementById('sys-uptime').innerText = vps.uptime;
                document.getElementById('sys-disk').innerText = vps.disk;
            }
        } catch(e) {}
    }
    setInterval(fetchSystemStats, 2000); fetchSystemStats();

    async function fetchLogs(target) {
        document.getElementById('log-viewer').innerText = 'Fetching...';
        try {
            const res = await fetch('/admin/api/logs?target=' + target);
            const data = await res.json();
            document.getElementById('log-viewer').innerText = data.logs || 'No logs.';
        } catch(e) { document.getElementById('log-viewer').innerText = 'Error'; }
    }

    // Gallery Submit Fix
    const galleryForm = document.getElementById('gallery-form');
    if(galleryForm) {
        galleryForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-upload');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengunggah...';
            btn.disabled = true;
            try {
                const res = await fetch('/admin/api/gallery', { method: 'POST', body: new FormData(e.target) });
                const data = await res.json();
                if(res.ok && data.status === 'ok') {
                    showAlert('Gambar berhasil diunggah!');
                    e.target.reset();
                    fetchGallery();
                } else throw new Error(data.error || 'Upload failed');
            } catch(err) { showAlert(err.message, true); }
            btn.innerHTML = 'Unggah'; btn.disabled = false;
        });
    }

    async function fetchGallery() {
        try {
            const res = await fetch('/admin/api/gallery');
            if(!res.ok) return;
            const data = await res.json();
            const grid = document.getElementById('gallery-grid');
            if(!data.length) { grid.innerHTML = '<p style="color:var(--text-secondary); grid-column:1/-1; text-align:center;">Belum ada gambar.</p>'; return; }
            grid.innerHTML = data.map(g => `
                <div style="background:var(--bg-color); border:1px solid var(--border-color); border-radius:8px; overflow:hidden;">
                    <img src="${g.url}" style="width:100%; height:120px; object-fit:cover; display:block;">
                    <div style="padding:0.5rem; display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:0.8rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${g.title}">${g.title}</span>
                        <button class="btn btn-danger" style="padding:0.2rem 0.5rem; font-size:0.7rem;" onclick="deleteGallery('${g.id}')"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
            `).join('');
        } catch(e) {}
    }

    async function deleteGallery(id) {
        if(!confirm('Hapus gambar ini?')) return;
        try {
            const res = await fetch('/admin/api/gallery/' + id, { method: 'DELETE' });
            if(res.ok) {
                showAlert('Gambar dihapus!');
                fetchGallery();
            } else showAlert('Gagal menghapus', true);
        } catch(e) { showAlert(e.message, true); }
    }

    // -----------------------------------------------------
    // LIVE STATS
    // -----------------------------------------------------
    async function fetchLiveStats() {
        try {
            const res = await fetch('/api/stats');
            if(!res.ok) return;
            const data = await res.json();
            if(data) {
                document.getElementById('stat-totalChat').innerText = data.totalChat || 0;
                document.getElementById('stat-imageGenerated').innerText = data.imageGenerated || 0;
                document.getElementById('stat-whatsappUsers').innerText = data.whatsappUsers || 0;
                document.getElementById('stat-discordUsers').innerText = data.discordUsers || 0;
                document.getElementById('stat-aiRequests').innerText = data.aiRequests || 0;
                document.getElementById('stat-commands').innerText = data.commands || 0;
            }
        } catch (e) {
            // silent fail
        }
    }
    
    // Polling setiap 3 detik
    setInterval(fetchLiveStats, 2000);

    // Init
    loadFiles(currentFmPath);
    fetchGallery();
</script>
</html>
<% } %>
